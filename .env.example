# Web3Forms access key — the PUBLIC, browser-safe submit key. It is designed
# to ship in frontend code (rate limiting, domain checking and spam filtering
# are enforced server side), so it is not a secret — but it is still env-only
# and never committed. There is no other credential: the form POSTs JSON to
# https://api.web3forms.com/submit with this key in the body.
#
# Setup:
#   1. https://web3forms.com -> "Get Access Key" -> sign in with the inbox
#      that should receive submissions -> copy the key (it looks like a UUID)
#   2. Netlify -> Site configuration -> Environment variables ->
#      VITE_WEB3FORMS_KEY = that key
#   3. Deploy -> Trigger deploy -> Deploy without cache
#      (Vite inlines VITE_* vars at build time)
#
# Local dev: copy this file to .env (gitignored) and fill it in.
VITE_WEB3FORMS_KEY=your-access-key-here
