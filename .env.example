# Copy to `.env` (git-ignored) to override compose defaults.

# Which image to run. Leave unset to build locally from the Dockerfile, or
# point at the immutable GHCR tag produced by .github/workflows/docker.yml.
# IMAGE=ghcr.io/your-owner/editorial-devops-portfolio:abc1234
IMAGE=editorial-devops-portfolio:local

# Host port the site is published on (container always listens on 8080).
PORT=8080

# Optional: OCI label metadata, only used when building with `docker compose build`.
GIT_SHA=dev
VERSION=dev
BUILD_DATE=
# SOURCE=https://github.com/your-owner/editorial-devops-portfolio
SOURCE=


#docker compose build --no-cache --pull
#docker compose up -d --force-recreate
#trivy image --severity HIGH,CRITICAL --ignore-unfixed editorial-devops-portfolio:local