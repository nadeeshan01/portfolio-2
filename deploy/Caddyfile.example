# ============================================================================
# Copy to deploy/Caddyfile and replace both hostnames:
#   cp deploy/Caddyfile.example deploy/Caddyfile
#
# Caddy obtains and renews Let's Encrypt certificates automatically for these
# hostnames (TLS-ALPN + HTTP-01 on 443/80), redirects port 80 to HTTPS, and
# emits its own Strict-Transport-Security header — which is why the HSTS line
# in deploy/security-headers.conf stays commented out.
#
# Requires DNS A/AAAA records pointing at this host and inbound 80/443 open.
# No certificate files to manage.
# ============================================================================

yourdomain.com {
	encode gzip zstd

	# Security headers, SPA fallback and asset caching all live in the nginx
	# inside the portfolio container — the proxy stays a pure, dumb edge.
	reverse_proxy portfolio:8080
}

# Fold www into the apex (drop this block if you have no www record).
www.yourdomain.com {
	redir https://yourdomain.com{uri} permanent
}
