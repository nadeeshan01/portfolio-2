# ============================================================================
# Build-context trimmer. Anything listed here never reaches the daemon, so
# `COPY . `-style steps stay small and secrets can't leak into layers.
# ============================================================================

# Dependencies & build output (rebuilt inside the image)
node_modules
dist
dist-ssr

# Git metadata — biggest context win, and no secrets in history
.git
.gitignore
.github

# Local-only artifacts
scratch
shots
*.log
npm-debug.log*
preview.log
*.local
.env
.env.*
!.env.example

# Docker/compose files themselves (invalidating cache on edit isn't worth it)
Dockerfile
.dockerignore
docker-compose*.yml
compose*.yml
compose*.yaml
deploy/Caddyfile

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Docs & local tooling config
README.md
tsconfig*.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
